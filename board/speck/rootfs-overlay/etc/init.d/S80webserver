#!/bin/sh
# Start the SpeckOS Local Web Server

case "$1" in
  start)
    echo -n "Launching SpeckOS local web engine... "
    # Run busybox httpd serving files from our custom /var/www directory
    httpd -h /var/www
    echo "OK"
    ;;
  stop)
    echo -n "Stopping SpeckOS local web engine... "
    killall httpd
    echo "OK"
    ;;
  restart|reload)
    $0 stop
    $0 start
    ;;
  *)
    echo "Usage: $0 {start|stop|restart}"
    exit 1
esac

exit 0
